{
  "name": "@tessel-la/roboboy-timeseries-panel",
  "version": "2.0.0",
  "description": "Configurable ROS time-series plotting panel for Robo-Boy",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "roboboy.panel.json",
    "README.md"
  ],
  "exports": "./dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2020 --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "integrity": "node scripts/print-integrity.mjs",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "validate": "npm run typecheck && npm test && npm run build && npm run validate:artifact"
  },
  "devDependencies": {
    "@tessel-la/roboboy-panel-sdk": "https://github.com/tessel-la/robo-boy/releases/download/panel-sdk-v2.0.0/tessel-la-roboboy-panel-sdk-2.0.0.tgz",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
