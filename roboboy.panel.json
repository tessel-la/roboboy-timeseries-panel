  "version": "2.1.1",
  "entryPoint": "./dist/index.js",
  "integrity": "sha256-DehtjHARPf1bs8cL50RntLIT7Aw5Vz5B13cIlKMEBmM=",
  "compatibility": {
    "panelApi": "^2.0.0",
    "roboboy": ">=0.3.0-0 <1.0.0"
  },
  "capabilities": ["ros", "storage"],
  "permissions": {
    "ros": {
      "selectTopic": true
    }
  },
  "author": {
    "name": "Tessella"
  },
  "repository": "https://github.com/tessel-la/roboboy-timeseries-panel",
  "tags": ["ros", "telemetry", "plot", "timeseries"]
}
